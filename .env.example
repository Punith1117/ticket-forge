POSTGRES_USER=ticketforge
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ticketforge
TEST_POSTGRES_DB=ticketforge_test
POSTGRES_PORT=5433

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@ticketforge.local

# AES-256-GCM Token Encryption Key (64 lowercase hexadecimal characters = 32 bytes)
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_ACTIVE_KEY_VERSION=1
TOKEN_ENCRYPTION_KEY=

# Application rate limiting
# Generate with: openssl rand -hex 32
RATE_LIMIT_HMAC_SECRET=

# Trusted proxy IPs or CIDRs for client IP extraction (comma-separated).
# X-Forwarded-For and X-Real-IP are only trusted when the immediate connecting
# peer matches an entry in this list.
# When absent or empty, only the TCP RemoteAddr is used; forwarded headers are ignored.
# Example: TRUSTED_PROXIES=10.0.0.0/8,172.16.0.1
TRUSTED_PROXIES=
